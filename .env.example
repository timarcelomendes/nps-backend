# Copie para .env e preencha (NUNCA suba o .env para o GitHub)

# Banco PostgreSQL (no Render: Internal Database URL)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Segurança
JWT_SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
# gere com: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Ambiente
FRONTEND_URL=http://localhost:5173
AMBIENTE=dev

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE=pesquisa@rakiti.com
EMAIL_REMETENTE_NOME=Rakiti

# IA da plataforma (incluída no plano dos clientes)
OPENAI_API_KEY=
IA_LIMITE_MENSAL=500

# Admin inicial (criado automaticamente se o banco estiver vazio)
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
DOMINIOS_PERMITIDOS=

# Administração da plataforma (pode criar contas de clientes). Separe por vírgula.
SUPERADMIN_EMAILS=
# URL pública da API (opcional; usada no link do webhook)
API_PUBLIC_URL=
